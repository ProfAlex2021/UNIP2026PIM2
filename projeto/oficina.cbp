				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/oficina" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="-finput-charset=UTF-8" />
			<Add option="-fexec-charset=CP850" />
		</Compiler>
		<Unit filename="agendamento.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="agendamento.h" />
